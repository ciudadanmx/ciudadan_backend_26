{
  "kind": "collectionType",
  "collectionName": "carros",
  "info": {
    "singularName": "carro",
    "pluralName": "carros",
    "displayName": "carros",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "conductoremail": {
      "type": "email"
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "conductor": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "fecharegistro": {
      "type": "datetime"
    },
    "marca": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "nombre": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "modelo": {
      "type": "integer",
      "min": 1980,
      "max": 2035
    },
    "puertas": {
      "type": "integer",
      "min": 2,
      "max": 8
    },
    "caracteristicas": {
      "type": "json"
    },
    "observaciones": {
      "type": "text",
      "maxLength": 500
    },
    "charla": {
      "type": "enumeration",
      "enum": [
        "silencio",
        "ligera",
        "social",
        "indiferente"
      ],
      "default": "indiferente"
    },
    "musica": {
      "type": "enumeration",
      "enum": [
        "sin música",
        "música suave",
        "pasajero elige",
        "indiferente"
      ],
      "default": "indiferente"
    },
    "tipo_musica": {
      "type": "json"
    },
    "wifi": {
      "type": "boolean",
      "default": false
    },
    "agua": {
      "type": "boolean",
      "default": false
    },
    "cargador": {
      "type": "boolean",
      "default": false
    },
    "snacks": {
      "type": "boolean",
      "default": false
    },
    "portabici": {
      "type": "boolean",
      "default": false
    },
    "accesibilidad": {
      "type": "boolean",
      "default": false
    },
    "mascotas": {
      "type": "boolean",
      "default": false
    },
    "fumadores": {
      "type": "boolean",
      "default": false
    },
    "aire_acondicionado": {
      "type": "boolean",
      "default": false
    },
    "rockola": {
      "type": "boolean",
      "default": false
    },
    "ambiente_inclusivo": {
      "type": "boolean",
      "default": false
    },
    "otro_genero": {
      "type": "boolean",
      "default": false
    },
    "ultimaverificacion": {
      "type": "datetime"
    },
    "verificaciones": {
      "type": "json"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pendiente",
        "activo",
        "revision",
        "suspendido"
      ],
      "default": "pendiente"
    },
    "agencia": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::agencia.agencia"
    }
  }
}
