      "target": "plugin::users-permissions.user"
    },
    "fecharegistro": {
      "type": "datetime"
    },
    "marca": {
      "type": "string"
    },
    "nombre": {
      "type": "string"
    },
    "modelo": {
      "type": "integer"
    },
    "caracteristicas": {
      "type": "json"
    },
    "observaciones": {
      "type": "text"
    }
  }
